{
  "name": "cf_ai_memory_test",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:wasm && vite dev",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "bench:budget": "tsx scripts/bench-budget.ts",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:wasm && vitest run",
    "test:rust": "cargo test --manifest-path rust/budget/Cargo.toml",
    "smoke:models": "tsx scripts/model-smoke.ts",
    "generate:filler": "tsx scripts/generate-filler.ts",
    "experiment": "tsx scripts/run-experiment.ts",
    "experiment:status": "tsx scripts/experiment-status.ts",
    "labels": "tsx scripts/labels.ts",
    "db:migrate": "wrangler d1 migrations apply cf-ai-memory-results --remote",
    "debug:stream": "tsx scripts/debug-stream.ts",
    "debug:summary": "tsx scripts/debug-summary.ts",
    "pilot:report": "tsx scripts/pilot-report.ts",
    "regrade": "tsx scripts/regrade.ts",
    "write:conversations": "tsx scripts/write-main-conversations.ts",
    "export:results": "tsx scripts/export-results.ts",
    "judge": "tsx scripts/judge.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.140",
    "@cloudflare/think": "0.20.2",
    "agents": "0.28.0",
    "ai": "7.0.137",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workers-ai-provider": "4.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
