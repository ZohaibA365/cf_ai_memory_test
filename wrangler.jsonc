{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-memory-test",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "CutoffAgent", "name": "CutoffAgent" },
      { "class_name": "BuiltinAgent", "name": "BuiltinAgent" },
      { "class_name": "SearchAgent", "name": "SearchAgent" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["ChatAgent"], "tag": "v1" },
    {
      "new_sqlite_classes": ["CutoffAgent", "BuiltinAgent", "SearchAgent"],
      "deleted_classes": ["ChatAgent"],
      "tag": "v2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-ai-memory-results",
      "database_id": "dd73c48b-e1d9-48ef-bfe6-24fd27fc0105",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "experiment-runner",
      "binding": "EXPERIMENT_RUNNER",
      "class_name": "ExperimentRunner"
    }
  ],
  // "mock" swaps in a fake model; only the test config sets it.
  "vars": { "MODEL_MODE": "live" },
  "observability": { "enabled": true }
}
